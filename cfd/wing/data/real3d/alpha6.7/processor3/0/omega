FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];


internalField   uniform 1.95;

boundaryField
{
    duvar
    {
        type            omegaWallFunction;
        blended         true;
        value           uniform 1.95;
    }
    disalan
    {
        type            freestream;
        freestreamValue uniform 1.95;
        value           uniform 1.95;
    }
    cikis
    {
        type            zeroGradient;
    }
    kok
    {
        type            symmetryPlane;
    }
    uc
    {
        type            freestream;
        freestreamValue uniform 1.95;
        value           uniform 1.95;
    }
    procBoundary3to1
    {
        type            processor;
        value           uniform 1.95;
    }
    procBoundary3to2
    {
        type            processor;
        value           uniform 1.95;
    }
}


