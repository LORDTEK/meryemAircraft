FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];


internalField   uniform 0;

boundaryField
{
    duvar
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
    disalan
    {
        type            freestream;
        freestreamValue uniform 0;
        value           uniform 0;
    }
    cikis
    {
        type            calculated;
        value           nonuniform 0();
    }
    kok
    {
        type            symmetryPlane;
    }
    uc
    {
        type            freestream;
        freestreamValue uniform 0;
        value           uniform 0;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary0to2
    {
        type            processor;
        value           uniform 0;
    }
}


