FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];


internalField   uniform 1.5e-06;

boundaryField
{
    duvar
    {
        type            kqRWallFunction;
        value           uniform 1e-14;
    }
    disalan
    {
        type            freestream;
        freestreamValue uniform 1.5e-06;
        value           uniform 1.5e-06;
    }
    cikis
    {
        type            zeroGradient;
    }
    kok
    {
        type            symmetryPlane;
    }
    uc
    {
        type            freestream;
        freestreamValue uniform 1.5e-06;
        value           uniform 1.5e-06;
    }
    procBoundary2to0
    {
        type            processor;
        value           uniform 1.5e-06;
    }
    procBoundary2to1
    {
        type            processor;
        value           uniform 1.5e-06;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 1.5e-06;
    }
}


